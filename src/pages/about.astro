---
import Footer from '../components/Footer.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

const pageTitle = "Acerca de Mi";

const identidad = {
    primerNombre: "Luis",
    pais: "Mexico",
    ocupacion: "Estudiante",
    hobbies: ["videojuegos", "musica", "peliculas"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro"];

const happy = true;
const finished = false;
const goal = 3;

const skillColor = "crimson";
const skillWeight = "bold";
const skillCase = "uppercase";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>

    <Navigation />

    <body>
        <h1>{pageTitle}</h1>
        <style define:vars={{skillColor, skillWeight, skillCase}}>
            h1 {
                color: purple;
                font-size: 4rem;
            }
            .skill {
                color: var(--skillColor);
                font-weight: var(--skillWeight);
                text-transform: var(--skillCase);
            }
        </style>

        <p>Algunos datos sobre mi:</p>
        <ul>
            <li>Mi nombre es: {identidad.primerNombre}</li>
            <li>
                Vivo en {identidad.pais} y mi ocupacion es ser {
                    identidad.ocupacion
                }
            </li>
            {
                identidad.hobbies.length >= 2 && (
                    <li>
                        Dos de mis hobbies son: {identidad.hobbies[0]} y{" "}
                        {identidad.hobbies[1]}
                    </li>
                )
            }
        </ul>

        <p>Mis habilidades son:</p>
        <ul>
            {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>

        {happy && <p>Estoy muy feliz de poder usar Astro</p>}

        {finished && <p>He acabado el tutorial</p>}

        {
            goal === 3 ? (
                <p>Mi objetivo es terminarlo antes de las 8pm de mañana</p>
            ) : (
                <p>Mi objetivo no es terminarlo mañana</p>
            )
        }

        <Footer />
    </body>
</html>